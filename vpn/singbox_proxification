#!/usr/bin/env bash
# Sing-Box Proxification Launcher for OmniTunnel CLI
PROJECT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
export PATH="$PROJECT_DIR/bin:$PATH"

SINGBOX_BIN="$(python3 -c 'import sys; sys.path.insert(0, "'"$PROJECT_DIR"'"); from src.singbox_adapter import find_singbox_binary; print(find_singbox_binary() or "")')"

if [ -z "$SINGBOX_BIN" ]; then
    echo "✕ Warning: sing-box binary not found. Falling back to legacy redsocks."
    exec bash "$PROJECT_DIR/vpn/proxification"
    exit 1
fi

CONFIG_FILE="$PROJECT_DIR/cfgs/singbox_config.json"

# Generate fresh sing-box JSON configuration from unified active.ot
python3 -c "
import sys, os
sys.path.insert(0, '$PROJECT_DIR')
from src.menu_common import read_config, status_snapshot
from src.singbox_adapter import generate_singbox_config, save_singbox_config

config = read_config()
s = status_snapshot(config)
mode = s['mode']

# v2ray mode: if json profile exists, copy it directly; else generate from config
if mode == 'v2ray':
    v2ray_cfg_path = s.get('v2ray_config')
    # also try configparser fallback
    try:
        v2ray_cfg_path = config.get('v2ray', 'v2ray_config', fallback=v2ray_cfg_path)
    except:
        pass
    if v2ray_cfg_path and os.path.exists(v2ray_cfg_path):
        import shutil, json
        # validate it is a valid sing-box config before copying
        try:
            with open(v2ray_cfg_path, 'r', encoding='utf-8') as f:
                json.load(f)
            shutil.copyfile(v2ray_cfg_path, '$CONFIG_FILE')
        except Exception as e:
            print(f'Warning: v2ray config invalid ({e}) — generating default', flush=True)
            sb_cfg = generate_singbox_config(config, socks_port=1080)
            save_singbox_config(sb_cfg, '$CONFIG_FILE')
    else:
        if v2ray_cfg_path:
            print(f'Warning: v2ray config not found at {v2ray_cfg_path} — generating default SOCKS config', flush=True)
        sb_cfg = generate_singbox_config(config, socks_port=1080)
        save_singbox_config(sb_cfg, '$CONFIG_FILE')
else:
    sb_cfg = generate_singbox_config(config, socks_port=1080)
    save_singbox_config(sb_cfg, '$CONFIG_FILE')
"

echo "✔ Starting sing-box High-Performance TUN Engine..."
exec "$SINGBOX_BIN" run -c "$CONFIG_FILE" 2>&1 | python3 -c "
import sys
sys.path.insert(0, '$PROJECT_DIR')
from src.logger import log_singbox
for line in sys.stdin:
    l = line.strip()
    if l:
        log_singbox(l)
"
