#!/usr/bin/env bash
# Sing-Box Proxification Launcher for OmniTunnel CLI
PROJECT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
export PATH="$PROJECT_DIR/bin:$PATH"

# Engine resolution: OMNI_ENGINE env (set by ssh.py) wins, otherwise the
# engine_mode stored in the active profile. Values: singbox | singbox-lx.
ENGINE_BIN="$(OMNI_ENGINE="${OMNI_ENGINE:-}" python3 -c 'import sys, os; sys.path.insert(0, "'"$PROJECT_DIR"'"); from src.menu_common import read_config, status_snapshot; from src.singbox_adapter import find_engine_binary; engine = os.environ.get("OMNI_ENGINE") or status_snapshot(read_config())["engine_mode"]; print(engine + "|" + (find_engine_binary(engine) or ""))')"
ENGINE="${ENGINE_BIN%%|*}"
SINGBOX_BIN="${ENGINE_BIN#*|}"

if [ -z "$SINGBOX_BIN" ]; then
    if [ "$ENGINE" = "singbox-lx" ]; then
        echo "✕ sing-box-lx engine selected but binary not found — install it with:"
        echo "  curl -fsSL https://raw.githubusercontent.com/RadouaneElarfaoui/omnitunnel-cli/main/install-singbox-lx.sh | sudo bash"
        echo "  Not falling back: this profile needs the XHTTP transport."
        exit 1
    fi
    echo "✕ Warning: sing-box binary not found. Falling back to legacy redsocks."
    exec bash "$PROJECT_DIR/vpn/proxification"
    exit 1
fi

# Per-instance ports: orchestrator (runvpn.sh) or ssh.py exports OMNI_* env.
# Fall back to allocating free ports here so direct launches also survive.
if [ -z "$OMNI_SSH_SOCKS_PORT" ] || [ -z "$OMNI_SOCKS_IN_PORT" ] || [ -z "$OMNI_HTTP_IN_PORT" ]; then
    eval "$(python3 -c "
import sys; sys.path.insert(0, '$PROJECT_DIR')
from src.ports import allocate_proxy_ports
import os
p = allocate_proxy_ports(
    ssh_socks=os.environ.get('OMNI_SSH_SOCKS_PORT'),
    socks_in=os.environ.get('OMNI_SOCKS_IN_PORT'),
    http_in=os.environ.get('OMNI_HTTP_IN_PORT'),
)
print('OMNI_SSH_SOCKS_PORT=%s OMNI_SOCKS_IN_PORT=%s OMNI_HTTP_IN_PORT=%s' % (p['ssh_socks'], p['socks_in'], p['http_in']))
" 2>/dev/null)"
fi
export OMNI_SSH_SOCKS_PORT="${OMNI_SSH_SOCKS_PORT:-1080}"
export OMNI_SOCKS_IN_PORT="${OMNI_SOCKS_IN_PORT:-1081}"
export OMNI_HTTP_IN_PORT="${OMNI_HTTP_IN_PORT:-8080}"

# Per-instance config file in proxy mode so parallel proxies don't
# overwrite each other. TUN mode keeps the legacy stable path.
if [ "${OUTPUT_MODE:-tun}" = "socks" ]; then
    CONFIG_FILE="$PROJECT_DIR/cfgs/singbox_config_${OMNI_SOCKS_IN_PORT}.json"
else
    CONFIG_FILE="$PROJECT_DIR/cfgs/singbox_config.json"
fi

# VayDNS mode: backend listen ports + forwarder SOCKS ports live in files
# (per-instance in proxy mode) so the EXIT trap stops exactly this
# instance's processes — never another parallel proxy's.
if [ "${OUTPUT_MODE:-tun}" = "socks" ]; then
    VAYDNS_PORTS_FILE="/tmp/omnitunnel-vaydns-${OMNI_SOCKS_IN_PORT}.ports"
    VAYDNS_SOCKS_FILE="/tmp/omnitunnel-vaydns-${OMNI_SOCKS_IN_PORT}.socks"
else
    VAYDNS_PORTS_FILE="/tmp/omnitunnel-vaydns-tun.ports"
    VAYDNS_SOCKS_FILE="/tmp/omnitunnel-vaydns-tun.socks"
fi
vaydns_cleanup() {
    if [ -f "$VAYDNS_SOCKS_FILE" ]; then
        python3 "$PROJECT_DIR/src/vaydns.py" down --socks "$(cat "$VAYDNS_SOCKS_FILE" 2>/dev/null)" 2>/dev/null || true
        rm -f "$VAYDNS_SOCKS_FILE" 2>/dev/null || true
    fi
    if [ -f "$VAYDNS_PORTS_FILE" ]; then
        python3 "$PROJECT_DIR/src/vaydns.py" down --ports "$(cat "$VAYDNS_PORTS_FILE" 2>/dev/null)" 2>/dev/null || true
        rm -f "$VAYDNS_PORTS_FILE" 2>/dev/null || true
    fi
}
# Set now (not after bring-up): Ctrl+C / TERM during the 30s backend wait
# must still reap spawned clients. No-op for other modes (files absent).
trap vaydns_cleanup EXIT INT TERM

# Generate fresh sing-box JSON configuration from unified active.ot
OUTPUT_MODE="${OUTPUT_MODE:-tun}"
OMNI_SSH_SOCKS_PORT="$OMNI_SSH_SOCKS_PORT" OMNI_SOCKS_IN_PORT="$OMNI_SOCKS_IN_PORT" OMNI_HTTP_IN_PORT="$OMNI_HTTP_IN_PORT" python3 -c "
import sys, os
sys.path.insert(0, '$PROJECT_DIR')
from src.menu_common import read_config, status_snapshot
from src.singbox_adapter import generate_singbox_config, save_singbox_config, apply_output_mode
from src.ports import get_env_port

config = read_config()
s = status_snapshot(config)
mode = s['mode']
output_mode = '$OUTPUT_MODE'
config_file = '$CONFIG_FILE'
ssh_socks = get_env_port('OMNI_SSH_SOCKS_PORT', 1080)
socks_in = get_env_port('OMNI_SOCKS_IN_PORT', 1081)
http_in = get_env_port('OMNI_HTTP_IN_PORT', 8080)

# v2ray mode: if json profile exists, copy it directly; else generate from config
if mode == 'v2ray':
    v2ray_cfg_path = s.get('v2ray_config')
    # also try configparser fallback
    try:
        v2ray_cfg_path = config.get('v2ray', 'v2ray_config', fallback=v2ray_cfg_path)
    except:
        pass
    if v2ray_cfg_path and os.path.exists(v2ray_cfg_path):
        import json
        # Saved profiles are TUN-only (output mode isn't known at import);
        # rewrite inbounds for the runtime mode so proxy gets socks+http on
        # this instance's ports instead of a verbatim TUN copy.
        try:
            with open(v2ray_cfg_path, 'r', encoding='utf-8') as f:
                saved = json.load(f)
            runtime = apply_output_mode(saved, output_mode=output_mode,
                                        socks_in_port=socks_in, http_in_port=http_in)
            save_singbox_config(runtime, config_file)
        except Exception as e:
            print(f'Warning: v2ray config invalid ({e}) — generating default', flush=True)
            sb_cfg = generate_singbox_config(config, socks_port=ssh_socks, output_mode=output_mode,
                                             socks_in_port=socks_in, http_in_port=http_in)
            save_singbox_config(sb_cfg, config_file)
    else:
        if v2ray_cfg_path:
            print(f'Warning: v2ray config not found at {v2ray_cfg_path} — generating default SOCKS config', flush=True)
        sb_cfg = generate_singbox_config(config, socks_port=ssh_socks, output_mode=output_mode,
                                         socks_in_port=socks_in, http_in_port=http_in)
        save_singbox_config(sb_cfg, config_file)
elif mode == 'vaydns':
    # VayDNS stack, in order: clients -> wait banners -> ssh -D forwarders
    # (one handshake each, multiplexed) -> wait SOCKS -> sing-box over the
    # forwarders. Fail closed at every step, leaking nothing.
    from src.vaydns import (generate_vaydns_singbox_config, allocate_vaydns_stack,
                            spawn_clients, spawn_forwarders, build_forwarder_cmd,
                            stop_clients, stop_forwarders, wait_for_backends,
                            wait_for_socks_ports, find_vaydns_binary, find_sshpass,
                            VAYDNS_INSTALL_HINT, resolve_pubkey_file)
    binary = find_vaydns_binary()
    if not binary:
        print(f'✕ {VAYDNS_INSTALL_HINT}', flush=True)
        raise SystemExit(1)
    domain = config.get('vaydns', 'domain', fallback='')
    tcp = config.get('vaydns', 'tcp', fallback='8.8.8.8:53') or '8.8.8.8:53'
    pubkey = resolve_pubkey_file(dict(config['vaydns']) if config.has_section('vaydns') else {}, domain or 'vaydns')
    try:
        instances = config.get('vaydns', 'instances', fallback='2')
    except:
        instances = '2'
    if not domain:
        print('✕ VayDNS domain is not configured (menu: Edit)', flush=True)
        raise SystemExit(1)
    if not pubkey:
        print('✕ VayDNS pubkey is not configured (menu: Edit or re-import link)', flush=True)
        raise SystemExit(1)
    user = config.get('ssh', 'username', fallback='')
    password = config.get('ssh', 'password', fallback='')
    auth_method = config.get('ssh', 'auth_method', fallback='password')
    if not user:
        print('✕ VayDNS needs the shared SSH username (menu: Edit)', flush=True)
        raise SystemExit(1)
    if auth_method.strip().lower() != 'publickey' and not find_sshpass():
        print('✕ sshpass not found (password auth needs it): sudo apt install -y sshpass', flush=True)
        raise SystemExit(1)
    log_level = config.get('engine', 'singbox_log_level', fallback='warn')
    if log_level not in ('info', 'debug', 'warn', 'error'):
        log_level = 'warn'
    backend_ports, socks_ports = allocate_vaydns_stack(instances)
    spawn_clients(binary, tcp, pubkey, domain, backend_ports)
    with open('$VAYDNS_PORTS_FILE', 'w', encoding='utf-8') as f:
        f.write(' '.join(str(p) for p in backend_ports))
    # DNS handshake takes seconds — wait for SSH banners so nothing starts
    # against dead backends (empty balance group + check timeouts).
    missing = wait_for_backends(backend_ports)
    if missing:
        print('✕ vaydns-client backend(s) never came up:', ', '.join('127.0.0.1:%s' % p for p in missing), flush=True)
        print('  Check domain / shared key / server, then retry (wait: OMNI_VAYDNS_WAIT_SECS)', flush=True)
        stop_clients(backend_ports)
        raise SystemExit(1)
    try:
        specs = [build_forwarder_cmd(user, b, s, auth_method, password)
                 for b, s in zip(backend_ports, socks_ports)]
    except ValueError as e:
        print(f'✕ {e}', flush=True)
        stop_clients(backend_ports)
        raise SystemExit(1)
    spawn_forwarders(specs)
    with open('$VAYDNS_SOCKS_FILE', 'w', encoding='utf-8') as f:
        f.write(' '.join(str(p) for p in socks_ports))
    missing_socks = wait_for_socks_ports(socks_ports)
    if missing_socks:
        print('✕ ssh forwarder(s) never came up:', ', '.join('127.0.0.1:%s' % p for p in missing_socks), flush=True)
        stop_forwarders(socks_ports)
        stop_clients(backend_ports)
        raise SystemExit(1)
    print('Stack up: %d backend(s) 127.0.0.1:%s -> ssh -D 127.0.0.1:%s' % (
        len(backend_ports),
        ', 127.0.0.1:'.join(str(p) for p in backend_ports),
        ', 127.0.0.1:'.join(str(p) for p in socks_ports)), flush=True)
    sb_cfg = generate_vaydns_singbox_config(user, password, socks_ports,
                                            output_mode=output_mode,
                                            socks_in_port=socks_in,
                                            http_in_port=http_in,
                                            log_level=log_level)
    save_singbox_config(sb_cfg, config_file)
else:
    sb_cfg = generate_singbox_config(config, socks_port=ssh_socks, output_mode=output_mode,
                                     socks_in_port=socks_in, http_in_port=http_in)
    save_singbox_config(sb_cfg, config_file)
" || exit 1

# Bake outbound server IPs: resolve domain endpoints via system DNS at
# launch so the tunnel never has to resolve its own server through itself
# (DoH detours through the outbound being dialed = deadlock). TLS SNI and
# Host headers already carry the hostname, so replacing server with its IP
# changes nothing on the wire. Re-resolved on every (re)connect; unresolvable
# hosts are left as-is.
python3 -c "
import json, socket
path = '$CONFIG_FILE'
with open(path, encoding='utf-8') as f:
    cfg = json.load(f)
def is_ip(host):
    for family in (socket.AF_INET, socket.AF_INET6):
        try:
            socket.inet_pton(family, host)
            return True
        except OSError:
            pass
    return False
for outbound in cfg.get('outbounds', []):
    host = outbound.get('server', '')
    if host and not is_ip(host):
        try:
            ip = socket.gethostbyname(host)
        except Exception as e:
            print(f'Warning: cannot resolve {host} ({e}) — leaving as-is', flush=True)
            continue
        print(f'Resolved {host} -> {ip}', flush=True)
        outbound['server'] = ip
with open(path, 'w', encoding='utf-8') as f:
    json.dump(cfg, f, ensure_ascii=False, indent=2)
"

# Fail closed with a clear message when a profile needs XHTTP but the
# stock engine is selected (stock sing-box would die on unknown transport).
if [ "$ENGINE" != "singbox-lx" ]; then
    if python3 -c "import json, sys; cfg = json.load(open('$CONFIG_FILE')); sys.exit(0 if any(((o.get('transport') or {}).get('type') == 'xhttp') for o in cfg.get('outbounds', [])) else 1)"; then
        echo "✕ This profile uses the XHTTP transport — switch engine to sing-box-lx"
        echo "  (menu: Edit → Engine) or install it with:"
        echo "  curl -fsSL https://raw.githubusercontent.com/RadouaneElarfaoui/omnitunnel-cli/main/install-singbox-lx.sh | sudo bash"
        exit 1
    fi
fi

# VayDNS owns child processes (backend clients) — no exec here: run
# sing-box in the foreground under a trap so the backends die with it.
# Every other mode keeps the legacy exec tail below.
VAYDNS_ACTIVE=0
MODE_NOW="$(python3 -c 'import sys; sys.path.insert(0, "'"$PROJECT_DIR"'"); from src.menu_common import read_config, status_snapshot; print(status_snapshot(read_config())["mode"])' 2>/dev/null)"
if [ "$MODE_NOW" = "vaydns" ]; then
    VAYDNS_ACTIVE=1
fi

if [ "$VAYDNS_ACTIVE" = "1" ]; then
    if [ "$OUTPUT_MODE" = "socks" ]; then
        echo "✔ Starting $ENGINE Proxy Engine (VayDNS ×$(cat "$VAYDNS_PORTS_FILE" 2>/dev/null | wc -w) backend(s))..."
        echo "  SOCKS5 → 0.0.0.0:$OMNI_SOCKS_IN_PORT (balanced over ssh -D 127.0.0.1:$(cat "$VAYDNS_SOCKS_FILE" 2>/dev/null | tr ' ' ','))"
        echo "  HTTP   → 0.0.0.0:$OMNI_HTTP_IN_PORT"
        echo "  config → $CONFIG_FILE"
    else
        echo "✔ Starting $ENGINE High-Performance TUN Engine (VayDNS)..."
    fi
    "$SINGBOX_BIN" run -c "$CONFIG_FILE" 2>&1 | python3 -c "
import sys
sys.path.insert(0, '$PROJECT_DIR')
from src.logger import log_singbox
for line in sys.stdin:
    l = line.strip()
    if l:
        log_singbox(l)
"
    exit $?
fi

if [ "$OUTPUT_MODE" = "socks" ]; then
    echo "✔ Starting $ENGINE Proxy Engine..."
    echo "  SOCKS5 → 0.0.0.0:$OMNI_SOCKS_IN_PORT (upstream 127.0.0.1:$OMNI_SSH_SOCKS_PORT)"
    echo "  HTTP   → 0.0.0.0:$OMNI_HTTP_IN_PORT"
    echo "  config → $CONFIG_FILE"
else
    echo "✔ Starting $ENGINE High-Performance TUN Engine..."
fi
exec "$SINGBOX_BIN" run -c "$CONFIG_FILE" 2>&1 | python3 -c "
import sys
sys.path.insert(0, '$PROJECT_DIR')
from src.logger import log_singbox
for line in sys.stdin:
    l = line.strip()
    if l:
        log_singbox(l)
"
