# Local compiled binaries
bin/

# Temporary run configuration file
configFile

# Connection and execution logs
logs.txt
logs/

# Real sensitive configuration files (kept locally, ignored by git)
cfgs/settings.ini
cfgs/settings.ot
cfgs/publickey.pem
cfgs/singbox_config.json

# Ignore all profiles in cfgs/saved/ (keep folder via .gitkeep)
cfgs/saved/*
!cfgs/saved/.gitkeep

# Ignore all user .ot / .omni profile files EXCEPT example templates
*.omni
*.ot
!cfgs/settings.ot.example

# Python cache files
__pycache__/
src/__pycache__/
tests/__pycache__/
*.pyc
